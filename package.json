{
  "name": "aeronautica-atc",
  "version": "0.1.0",
  "description": "",
  "main": "src/app.js",
  "scripts": {
    "start": "node builder.js",
    "build": "pkg builder.js --targets node18-win-x64 --output aeronautica.exe"
  },
  "bin": "builder.js",
  "pkg": {
    "scripts": "output/src/**/*.js",
    "assets": [
      "output/**/*",
      "config/**/*",
      "!output/logs/*.log"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
  "author": "Cassitly",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "axios": "^1.8.4",
    "date-and-time": "^3.6.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "extract-zip": "^2.0.1",
    "ffmpeg": "^0.0.4",
    "ffmpeg-static": "^5.2.0",
    "fs": "^0.0.1-security",
    "groq-sdk": "^0.19.0",
    "node-fetch": "^3.3.2",
    "opusscript": "^0.0.8",
    "path": "^0.12.7",
    "prism-media": "^1.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
